{{- $gitName := promptStringOnce . "gitName" "Git name" "Johann Tan" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git email" "johann@jtan.me" -}}
{{- $trustedMac := false -}}
{{- if eq .chezmoi.os "darwin" -}}
	{{- $trustedMac = promptBoolOnce . "trustedMac" "Enable signing and Bitwarden secrets on this trusted Mac" false -}}
{{- end -}}
{{- $entry := "" -}}
{{- $ao3Entry := get . "ao3Entry" | default "" -}}
{{- $rcloneEntry := get . "rcloneEntry" | default "rclone" -}}
{{- if $trustedMac -}}
	{{- $entry = promptStringOnce . "signingKeyEntry" "Signing SSH-key Bitwarden item ID (or unique item name)" "git-ssh" -}}
	{{- if eq (trim $entry) "" -}}
		{{- fail "Trusted Mac setup requires a signing SSH-key Bitwarden item ID or unique name" -}}
	{{- end -}}
	{{- if lookPath "fanficfare" -}}
		{{- $ao3Entry = promptStringOnce . "ao3Entry" "AO3 Bitwarden item ID (or unique item name)" -}}
		{{- if eq (trim $ao3Entry) "" -}}
			{{- fail "FanFicFare credentials require an AO3 Bitwarden item ID or unique name" -}}
		{{- end -}}
	{{- end -}}
	{{- if lookPath "rclone" -}}
		{{- $rcloneEntry = promptStringOnce . "rcloneEntry" "Rclone config-password Bitwarden item ID (or unique item name)" "rclone" -}}
		{{- if eq (trim $rcloneEntry) "" -}}
			{{- fail "Rclone config-password lookup requires a Bitwarden item ID or unique name" -}}
		{{- end -}}
	{{- end -}}
{{- end -}}
# Generated by chezmoi init. Passwords are never stored here.
[data]
	gitName = {{ $gitName | quote }}
	gitEmail = {{ $gitEmail | quote }}
	trustedMac = {{ $trustedMac }}
	ao3Entry = {{ $ao3Entry | quote }}
	rcloneEntry = {{ $rcloneEntry | quote }}
{{ if $trustedMac }}	signingKeyEntry = {{ $entry | quote }}

[bitwarden]
	command = "bwbio"
	unlock = "auto"
{{ end }}
[git]
	autoAdd = false
	autoCommit = false
	autoPush = false
