{{- $gitName := promptStringOnce . "gitName" "Git name" "Johann" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git email" "johann@jtan.me" -}}
{{- $trustedMac := false -}}
{{- if eq .chezmoi.os "darwin" -}}
	{{- $trustedMac = promptBoolOnce . "trustedMac" "Enable Strongbox signing and KeePassXC on this trusted Mac" false -}}
{{- end -}}
{{- $database := "" -}}
{{- $entry := "" -}}
{{- $attribute := "Public Key" -}}
{{- if $trustedMac -}}
	{{- $database = promptStringOnce . "keepassxcDatabase" "Local KDBX database path" -}}
	{{- $entry = promptStringOnce . "signingKeyEntry" "Signing key entry path (including groups)" -}}
	{{- $attribute = promptStringOnce . "signingKeyAttribute" "Signing public key attribute name" "Public key" -}}
	{{- if or (eq (trim $database) "") (eq (trim $entry) "") (eq (trim $attribute) "") -}}
		{{- fail "Trusted Mac setup requires a database path, signing entry, and public-key attribute name" -}}
	{{- end -}}
	{{- if hasPrefix "~/" $database -}}
		{{- $database = joinPath .chezmoi.homeDir (trimPrefix "~/" $database) -}}
	{{- end -}}
	{{- if not (hasPrefix "/" $database) -}}
		{{- fail "Use an absolute KDBX database path or a path starting with ~/" -}}
	{{- end -}}
{{- end -}}
# Generated by chezmoi init. Passwords are never stored here.
[data]
	gitName = {{ $gitName | quote }}
	gitEmail = {{ $gitEmail | quote }}
	trustedMac = {{ $trustedMac }}
{{ if $trustedMac }}	keepassxcDatabase = {{ $database | quote }}
	signingKeyEntry = {{ $entry | quote }}
	signingKeyAttribute = {{ $attribute | quote }}

[keepassxc]
	database = {{ $database | quote }}
	command = "keepassxc-cli"
	mode = "cache-password"
	prompt = true
{{ end }}
[git]
	autoAdd = false
	autoCommit = false
	autoPush = false
