{{- $gitName := promptStringOnce . "gitName" "Git name" "Johann" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git email" "johann@jtan.me" -}}
{{- $trustedMac := false -}}
{{- if eq .chezmoi.os "darwin" -}}
	{{- $trustedMac = promptBoolOnce . "trustedMac" "Enable Strongbox signing and secrets on this trusted Mac" false -}}
{{- end -}}
{{- $entry := "" -}}
{{- $attribute := "Public Key" -}}
{{- $ao3Entry := get . "ao3Entry" | default "" -}}
{{- if $trustedMac -}}
	{{- $entry = promptStringOnce . "signingKeyEntry" "Signing key entry path (including groups)" -}}
	{{- $attribute = promptStringOnce . "signingKeyAttribute" "Signing public key attribute name" "Public key" -}}
	{{- if or (eq (trim $entry) "") (eq (trim $attribute) "") -}}
		{{- fail "Trusted Mac setup requires a signing entry and public-key attribute name" -}}
	{{- end -}}
	{{- if lookPath "fanficfare" -}}
		{{- $ao3Entry = promptStringOnce . "ao3Entry" "AO3 Strongbox entry path (including groups)" -}}
		{{- if eq (trim $ao3Entry) "" -}}
			{{- fail "FanFicFare credentials require an AO3 Strongbox entry path" -}}
		{{- end -}}
	{{- end -}}
{{- end -}}
# Generated by chezmoi init. Passwords are never stored here.
[data]
	gitName = {{ $gitName | quote }}
	gitEmail = {{ $gitEmail | quote }}
	trustedMac = {{ $trustedMac }}
	ao3Entry = {{ $ao3Entry | quote }}
{{ if $trustedMac }}	signingKeyEntry = {{ $entry | quote }}
	signingKeyAttribute = {{ $attribute | quote }}

[secret]
	command = "strongbox"
{{ end }}
[git]
	autoAdd = false
	autoCommit = false
	autoPush = false
