{{- if and (eq .chezmoi.os "darwin") .trustedMac -}}
	{{- if eq .signingKeyEntry "" -}}
		{{- fail "Configure signingKeyEntry with chezmoi init" -}}
	{{- end -}}
	{{- $entry := bitwarden "item" .signingKeyEntry -}}
	{{- $sshKey := get $entry "sshKey" | default dict -}}
	{{- $key := get $sshKey "publicKey" | default "" | trim -}}
	{{- if not (regexMatch `^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com) [A-Za-z0-9+/]+={0,3}([ \t]+[^\r\n]*)?$` $key) -}}
		{{- fail "The Bitwarden SSH-key item must contain a single OpenSSH public key, not an empty value or private key" -}}
	{{- end -}}
	{{- $key -}}
{{- end -}}
