{{- if and (eq .chezmoi.os "darwin") .trustedMac -}}
	{{- if or (eq .signingKeyEntry "") (eq .signingKeyAttribute "") -}}
		{{- fail "Configure signingKeyEntry and signingKeyAttribute with chezmoi init" -}}
	{{- end -}}
	{{- $key := keepassxcAttribute .signingKeyEntry .signingKeyAttribute | trim -}}
	{{- if not (regexMatch `^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com) [A-Za-z0-9+/]+={0,3}([ \t]+[^\r\n]*)?$` $key) -}}
		{{- fail "The signing attribute must contain a single OpenSSH public key, not an empty value or private key" -}}
	{{- end -}}
	{{- $key -}}
{{- end -}}
