{{- if and (eq .chezmoi.os "darwin") .trustedMac -}}
	{{- $key := get . "signingKey" | default "" | trim -}}
	{{- if eq $key "" -}}
		{{- fail "Configure signingKey (the Secretive public key) with chezmoi init" -}}
	{{- end -}}
	{{- if not (regexMatch `^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com) [A-Za-z0-9+/]+={0,3}([ \t]+[^\r\n]*)?$` $key) -}}
		{{- fail "signingKey must be a single OpenSSH public key, not an empty value or private key" -}}
	{{- end -}}
	{{- $key -}}
{{- end -}}
